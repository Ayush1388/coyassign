# Local: a SQLite file. Production: a Turso URL, e.g. libsql://coy-discover-<you>.turso.io
DATABASE_URL=file:./data/coy.db
# Only needed for Turso. TURSO_DATABASE_URL / TURSO_AUTH_TOKEN (set by the Vercel Turso integration) also work.
DATABASE_AUTH_TOKEN=
# Enables POST /api/dev/reset and the "Reset demo" button (handy for reviewers)
DEMO_RESET=true
