{
  "name": "coy-discover",
  "version": "1.0.0",
  "description": "Swipe-based Discover tab for Coy: mutual-only matching, a privacy-first API and SQLite persistence.",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm db:setup",
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx db/setup.ts && next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:setup": "tsx db/setup.ts",
    "db:reset": "tsx db/setup.ts --reset",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "packageManager": "pnpm@12.9.1",
  "dependencies": {
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.77.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20.12"
  }
}
